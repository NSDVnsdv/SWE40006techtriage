# Below is the code to show the settings each server keeps in its own /opt/techtriage/.env file.
# Copy this file to .env and fill in real values. The real .env is never committed (.gitignore blocks it).

# Below is the code to name this server's environment: development, testing, staging or production.
APP_ENV=development

# Below is the code to say where Docker downloads the app image from (ghcr.io/<owner>/swe40006techtriage)
# and which version to run: a commit ID (SHA) chosen by the pipeline, or "latest".
GHCR_OWNER=nsdvnsdv
IMAGE_TAG=latest

# Below is the code to set this server's own database password: letters and numbers only, never shared between servers.
# On a server, make a random one with: openssl rand -hex 16
DB_PASSWORD=change-me-to-a-long-random-value

# Below is the code to optionally use a different port on your own computer (the servers use port 80).
# HOST_PORT=8080

# Below is the code to add the Production-only settings, written by monitoring/prod-enable-logging.sh.
# They send the app's logs to CloudWatch and keep the Level 2 test pages switched off.
# COMPOSE_FILE=compose.yaml:compose.monitoring.yaml
# AWS_REGION=us-east-1
# FAULT_INJECTION=0
