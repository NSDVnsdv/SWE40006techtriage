# Below is the code to keep secrets out of git, because the repo is PUBLIC: .env files, private keys and AWS credentials
# (.env.example is allowed, as it holds no real values).
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/

# Below is the code to ignore Python's cache files and the virtual environment.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Below is the code to ignore test and coverage output made on a PC (the pipeline saves its own copy with each run).
.pytest_cache/
.coverage
coverage.xml
htmlcov/
test-results/
playwright-report/
reports/

# Below is the code to ignore editor and operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db
